# Connection settings for `sentinel deploy`. Copy to `.env` (which is
# gitignored), fill in real values, and `source .env` before deploying.
# NEVER commit a filled-in copy — secrets stay out of the repository.

# Base Kibana URL of the target stack.
ELASTIC_URL=http://localhost:5601

# Preferred: a Kibana/Elasticsearch API key (base64 "id:api_key" value).
# Create one in Kibana > Stack Management > API keys.
ELASTIC_API_KEY=

# Fallback: HTTP basic auth. Used only when ELASTIC_API_KEY is empty.
# Matches the local docker-compose default credentials.
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=changeme123

# Password Kibana uses for its own system user (local stack only).
KIBANA_PASSWORD=changeme123

# --- AI rule generation (optional) -----------------------------------------
# Provider for `sentinel genrule`. Leave unset to auto-select: 'gemini' when
# GEMINI_API_KEY is present, otherwise the offline 'template' provider.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
